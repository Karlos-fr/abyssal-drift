    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/three": "0.170.0",
    "eslint": "10.10.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1"
  }
}
